# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Groq (LLM) --- https://console.groq.com/keys
GROQ_API_KEY=
# Overridable; live list at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# --- Tavily (web search) --- https://app.tavily.com
TAVILY_API_KEY=

# --- Fake mode ---
# 1 = run the full pipeline with stubbed Groq + Tavily (Chroma + embeddings still
# run for real). Lets you smoke-test wiring and demo the UI without API keys/credits.
FAKE_MODE=0

# --- Embeddings (local, free) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- CORS: comma-separated frontend origins allowed to call the API (step 2) ---
ALLOWED_ORIGINS=http://localhost:5173
